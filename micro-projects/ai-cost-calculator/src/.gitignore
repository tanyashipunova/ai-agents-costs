# .gitignore

# Кэш Python (компилированные файлы байт-кода)
__pycache__/
*.pyc
*.pyo
*.pyd

# Виртуальные окружения (если вы создаете их внутри папки проекта)
.env
.venv/
venv/
ENV/
env/

# Файлы настроек редакторов кода и IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Локальные системные файлы операционных систем
.DS_Store
Thumbs.db
